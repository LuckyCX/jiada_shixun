# Docker Compose 进程级（复制为 .env 后修改）
REDIS_PASSWORD=change-me-on-server

# 基础镜像：deploy.sh 菜单默认项；1=online 联网拉取，2=local 跳过已有（jxdx 可设为 local）
# DEPLOY_BASE_IMAGES=local

# 网关：宿主机端口 → gateway 容器 80
GATEWAY_PORT=18081

# PostgreSQL（仅 Compose 注入；业务密钥仍在库表 system_config）
POSTGRES_USER=jiada_shixun
POSTGRES_PASSWORD="jiuan@123"
POSTGRES_DB=jiada_shixun
POSTGRES_HOST_PORT=15434

# Node 基础镜像（API 与 gateway 前端构建共用，只拉一份；约 28MB 层为 Node 运行时）
NODE_IMAGE=docker.1ms.run/library/node:20-bookworm-slim

# Nginx（gateway 运行阶段）
NGINX_IMAGE=docker.1ms.run/library/nginx:1.27-alpine

# 数据库缓存（postgres 官方名即可；1ms 镜像站常无 postgres 清单）
POSTGRES_IMAGE=postgres:15-alpine
REDIS_IMAGE=docker.1ms.run/library/redis:7-alpine

# Node API（容器内）
PORT=4000
PG_POOL_MAX=30
LIBREOFFICE_BIN=/usr/bin/soffice

# 公网访问根地址（问卷外链等；生产填 https://你的域名，留空则按请求 Host）
PUBLIC_WEB_ORIGIN=

# 创世纪 EconoVerse 学生端（web 构建时注入；开发默认 http://localhost:5173）
# VITE_ECONOVERSE_ORIGIN=http://localhost:5173
