# 用于 FROM 的 ARG 必须写在首个 FROM 之前（BuildKit 要求）
# 默认与 node 服务共用同一 Node 基础镜像，避免重复下载 node:22 + node:20
ARG WEB_BUILD_NODE_IMAGE=docker.1ms.run/library/node:20-bookworm-slim
ARG NGINX_IMAGE=docker.1ms.run/library/nginx:1.27-alpine

FROM ${WEB_BUILD_NODE_IMAGE} AS webbuilder
WORKDIR /w
RUN corepack enable && corepack prepare pnpm@9.15.1 --activate
COPY web/package.json web/pnpm-lock.yaml ./
# 依赖走国内 npm 源，缩短 build 阶段（与基础镜像 pull 无关）
ENV npm_config_registry=https://registry.npmmirror.com
RUN pnpm install --frozen-lockfile
COPY web/ .
ENV BASE_PATH=/
ENV NODE_OPTIONS=--max-old-space-size=2048
RUN pnpm run build

# 创想小镇沙盒（PixiJS 独立子应用）→ /town-sandbox/
FROM ${WEB_BUILD_NODE_IMAGE} AS gamebuilder
WORKDIR /g
RUN corepack enable && corepack prepare pnpm@9.15.1 --activate
COPY game/package.json game/pnpm-lock.yaml ./
ENV npm_config_registry=https://registry.npmmirror.com
RUN pnpm install --frozen-lockfile
COPY game/ .
ENV NODE_OPTIONS=--max-old-space-size=2048
RUN pnpm run build

FROM ${NGINX_IMAGE}
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=webbuilder /w/out /usr/share/nginx/html
COPY --from=gamebuilder /g/dist /usr/share/nginx/html/town-sandbox
